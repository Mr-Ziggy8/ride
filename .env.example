# Copie ce fichier en .env.local puis remplis les valeurs depuis
# Firebase Console -> Project settings -> Vos applications -> config de l'app Web.
# .env.local est ignore par git, celui-ci (.env.example) est commite comme reference,
# sans valeurs reelles dedans.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
