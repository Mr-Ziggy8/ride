# Copie ce fichier en .env.local puis remplis les valeurs depuis
# Firebase Console -> Project settings -> Vos applications -> config de l'app Web.
# .env.local est ignore par git, celui-ci (.env.example) est commite comme reference,
# sans valeurs reelles dedans.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cote serveur uniquement (fonctions Vercel dans api/) - jamais prefixees VITE_,
# donc jamais exposees au bundle client. A configurer dans Vercel -> Project
# Settings -> Environment Variables, pas seulement ici en local.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Genere par Stripe au moment de creer le webhook (Developpeurs -> Webhooks),
# une fois l'URL de deploiement connue - donc rempli en dernier.
STRIPE_WEBHOOK_SECRET=
# Contenu JSON complet du fichier telecharge depuis Firebase Console ->
# Parametres du projet -> Comptes de service -> Generer une nouvelle cle privee.
FIREBASE_SERVICE_ACCOUNT=
